---
import type { Notebook, SectionWithPages } from "../lib/types";

interface Props {
  notebook: Notebook;
  sections: SectionWithPages[];
  currentPageId?: number;
}
const { notebook, sections, currentPageId } = Astro.props;
---

<nav class="nb-tree" aria-label={`${notebook.title} contents`}>
  {
    sections
      .filter((s) => s.pages.length)
      .map((s) => (
        <div class="nb-tree-section">
          <p class="nb-tree-title">{s.title}</p>
          <ol>
            {s.pages.map((p) => (
              <li>
                <a href={`/notebooks/${notebook.slug}/${s.slug}/${p.slug}`} aria-current={p.id === currentPageId ? "page" : undefined}>
                  {p.title}
                  {p.status === "draft" && <span class="draft-dot" title="Draft" />}
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
  }
</nav>

<style>
  .nb-tree-section + .nb-tree-section { margin-top: 1.1rem; }
  .nb-tree-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 0.3rem; }
  ol { list-style: none; padding: 0; margin: 0; }
  li { margin: 0; }
  a { display: block; padding: 0.3rem 0.6rem; border-left: 2px solid var(--color-border); color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.4; }
  a:hover { color: var(--color-text); border-left-color: var(--color-border-strong); text-decoration: none; }
  a[aria-current="page"] { color: var(--color-primary); border-left-color: var(--color-primary); font-weight: 500; }
  .draft-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; border: 1.5px solid var(--color-warning); margin-left: 0.35rem; vertical-align: middle; }
</style>
