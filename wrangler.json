{
	"name": "math-path",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "math-path",
			"database_id": "7741e284-271a-4e07-9319-4a577e904a4b",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "math-path-files"
		}
	],
	"routes": [
		{ "pattern": "math-path.kiaramaldonado.com", "custom_domain": true }
	],
	"observability": { "enabled": true },
	"upload_source_maps": true
}
